  "description": "",
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcrypt": "5.1.1",
    "cors": "^2.8.6",
    "express": "4.21.2",
    "express-async-errors": "3.1.1",
    "jsonwebtoken": "9.0.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "6.19.0",
    "supertest": "7.1.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  }
