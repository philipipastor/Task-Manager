{
  "name": "task-manager",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "test:dev": "set NODE_OPTIONS=--experimental-vm-modules && jest --watchAll --runInBand",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate && tsup src/server.ts --out-dir build",
    "start": "node build/server.js"
  },
